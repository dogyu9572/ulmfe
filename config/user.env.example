# 사용자(HKEGO_USER) env 예시
# 포트: 백엔드 9032 / 프론트 9132
# 공개 URL: https://use.go.kr/usfec (Next basePath=/usfec)
# 관리자: https://use.go.kr/usfec-adm · 태블릿: https://use.go.kr/usfec-tab
#
# 빌드 프로파일별 DB 기본값 (비밀번호만 실제 env에 주입)
# awsdev / dev / prod
#
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SERVER_PORT=9032
SERVER_ADDRESS=127.0.0.1
SERVER_SERVLET_CONTEXT_PATH=/usfec
FILE_UPLOAD_PATH=/home/ulmfe/uploads
# 오시는 길 카카오맵 JavaScript 키 (미설정 시 application.yml 기본값 사용)
# KAKAO_MAP_APP_KEY=
APP_CRYPTO_SECRET_KEY=CHANGE_ME_32_BYTE_SECRET_KEY_123
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_SESSION_COOKIE_SECURE=true
APP_CSRF_COOKIE_SAME_SITE=Lax
APP_CSRF_COOKIE_SECURE=true
