# 태블릿(HKEGO_TABLET) env 예시
# 포트: 백엔드 9033 / 프론트 9133
# 공개 URL: https://use.go.kr/usfec-tab
#
# 빌드 프로파일별 DB 기본값 (비밀번호만 실제 env에 주입)
# awsdev / dev / prod
#
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SERVER_PORT=9033
SERVER_ADDRESS=127.0.0.1
SERVER_SERVLET_CONTEXT_PATH=/usfec-tab
FILE_UPLOAD_PATH=/home/ulmfe/uploads
APP_SESSION_COOKIE_NAME=HKEGO_TABLET_SESSIONID
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_SESSION_COOKIE_SECURE=true
APP_CSRF_COOKIE_SAME_SITE=Lax
APP_CSRF_COOKIE_SECURE=true
DEV_WATCH=true
