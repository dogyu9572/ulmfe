# Next.js → Spring Boot (SSR/rewrite)
# 포트: 백엔드 9032 / 프론트 9132
# 공개 path: /usfec → 화면·API·uploads 모두 /usfec 하위
# Ingress: /usfec → Next(9132), /usfec/api|/uploads → Spring usfec.war (context-path /usfec) 그대로
API_BASE_URL=http://127.0.0.1:9032
NEXT_PUBLIC_BASE_PATH=/usfec
NEXT_PUBLIC_SITE_URL=https://use.go.kr/usfec
# 로컬 next 전용. WAR 배포 시에는 Spring application.yml app.kakao.map-app-key 를 쓴다.
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
