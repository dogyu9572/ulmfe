<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.let.adm.service.impl.AdminDAO">
	<resultMap id="AdminInfoMap" type="egovframework.let.adm.service.vo.AdminInfoVO">
		<id property="id" column="ID"/>
		<result property="userNm" column="USER_NM"/>
		<result property="emlAddr" column="EML_ADDR"/>
		<result property="enpswd" column="ENPSWD"/>
		<result property="acntSttsCd" column="ACNT_STTS_CD"/>
		<result property="authrtCd" column="AUTHRT_CD"/>
		<result property="regDt" column="REG_DT"/>
		<result property="mdfcnDt" column="MDFCN_DT"/>
		<result property="lastCntnDt" column="LAST_CNTN_DT"/>
	</resultMap>

	<select id="findById" parameterType="string" resultMap="AdminInfoMap">
		SELECT *
		FROM ADMIN_MST
		WHERE ID = #{id}
	</select>

	<sql id="adminListWhere">
		FROM ADMIN_MST
		WHERE 1 = 1
		<if test="status != null and status != ''">
			AND ACNT_STTS_CD = #{status}
		</if>
		<if test="role != null and role != ''">
			AND AUTHRT_CD = #{role}
		</if>
	</sql>

	<select id="countAdminList" resultType="int">
		SELECT COUNT(*)
		<include refid="adminListWhere"/>
	</select>

	<select id="selectAdminList" resultMap="AdminInfoMap">
		SELECT *
		<include refid="adminListWhere"/>
		ORDER BY REG_DT DESC
		LIMIT #{offset}, #{limit}
	</select>

	<insert id="insert" parameterType="egovframework.let.adm.service.vo.AdminInfoVO">
		INSERT INTO ADMIN_MST
		(
			ID,
			USER_NM,
			EML_ADDR,
			ENPSWD,
			ACNT_STTS_CD,
			AUTHRT_CD
		)
		VALUES
		(
			#{id},
			#{userNm},
			#{emlAddr},
			#{enpswd},
			#{acntSttsCd},
			#{authrtCd}
		)
	</insert>

	<update id="update" parameterType="egovframework.let.adm.service.vo.AdminInfoVO">
		UPDATE ADMIN_MST
		SET
			USER_NM = #{userNm},
			EML_ADDR = #{emlAddr},
			ACNT_STTS_CD = #{acntSttsCd},
			AUTHRT_CD = #{authrtCd}
		WHERE ID = #{id}
	</update>

	<update id="updatePassword">
		UPDATE ADMIN_MST
		SET ENPSWD = #{enpswd}
		WHERE ID = #{id}
	</update>

	<delete id="delete" parameterType="string">
		DELETE FROM ADMIN_MST
		WHERE ID = #{id}
	</delete>
</mapper>

